# Plantilla de variables de entorno. Copiar a .env y completar.
# .env esta en .gitignore: ningun secreto se commitea.
#
# Sin estas variables, application.yml usa por defecto el Postgres local de
# docker-compose.yml, cuyas credenciales son descartables y publicas.

# --- Postgres local (docker compose up -d) ---
PASSLY_DB_URL=jdbc:postgresql://localhost:5432/passly
PASSLY_DB_USER=passly
PASSLY_DB_PASSWORD=passly

# --- Supabase (cuando se migre) ---
# Usar SIEMPRE el puerto 5432 (conexion directa), NUNCA el 6543:
# el 6543 es PgBouncer en modo transaccion y rompe los prepared statements de JPA.
# Si aparecen errores raros de prepared statements, agregar ?prepareThreshold=0
#
# PASSLY_DB_URL=jdbc:postgresql://db.<proyecto>.supabase.co:5432/postgres
# PASSLY_DB_USER=postgres
# PASSLY_DB_PASSWORD=<password del proyecto>
