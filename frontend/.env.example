# Plantilla de variables de entorno para la app web. Copiar a .env (gitignored por la
# raíz del repo, que ya cubre .env/.env.* salvo este archivo).
#
# URL base del backend Spring Boot. Por defecto apunta al backend local (puerto 8080,
# ver docker-compose.yml / backend/src/main/resources/application.yml).
VITE_API_BASE_URL=http://localhost:8080
