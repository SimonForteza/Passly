# Plantilla de variables de entorno para la app web. Copiar a .env (gitignored por la
# raíz del repo, que ya cubre .env/.env.* salvo este archivo).
#
# En desarrollo, destino del proxy /api de Vite. El navegador usa siempre el mismo
# origen del frontend, para conservar la sesión del carrito. Reiniciar Vite al cambiarlo.
# En producción, URL de la API; omitirla si /api se sirve desde el mismo dominio.
VITE_API_BASE_URL=http://localhost:8080
